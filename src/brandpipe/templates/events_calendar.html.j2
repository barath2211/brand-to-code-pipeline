<section class="bp-card" aria-labelledby="cal-{{ brand.client_id }}">
  <h2 id="cal-{{ brand.client_id }}">Financial calendar</h2>
  <table class="bp-table">
    <thead><tr><th scope="col">Date</th><th scope="col">Event</th></tr></thead>
    <tbody>
    {% for ev in content.events %}<tr><td>{{ ev.date }}</td><td>{{ ev.title }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
</section>
